# Faceless AI Insurance Agent — Environment Variables
# Copy this file to .env.local and fill in your values

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for local dev)
DATABASE_URL="file:./dev.db"

# PostgreSQL (for production on Vercel + Supabase / Neon)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/faceless_insurance?schema=public"

# ─── OpenRouter AI ────────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai
# Can also be stored per-agent in the admin dashboard (DB)
OPENROUTER_API_KEY=""

# ─── Admin Auth ───────────────────────────────────────────────────────────────
# Simple password for admin dashboard (hash in production)
ADMIN_PASSWORD="change_me_in_production"
ADMIN_SECRET_KEY="your_random_secret_for_jwt"

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_AGENT_NAME="Aisha"

# ─── File Uploads ─────────────────────────────────────────────────────────────
# For Vercel: use Vercel Blob or AWS S3
# For local dev: files saved in /public/uploads
UPLOAD_DIR="./public/uploads"
